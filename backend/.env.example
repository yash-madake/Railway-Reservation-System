# Database Configuration
#
# Local development. To use the hosted Aiven instance instead, swap in its
# Service URI values — note it is NOT port 3306:
#
#   DB_HOST=mysql-yatrio-kharadeprathamesh7.b.aivencloud.com
#   DB_PORT=11499
#   DB_NAME=defaultdb
#   DB_USER=avnadmin
#   DB_PASSWORD=<from the Aiven console>
#
# The password must be URL-escaped if it contains @ : / ? # — Team 5 reads
# these as discrete variables, not out of a URI.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=yatrio_db

# ---- Team 5: MySQL TLS (payment schema) ----
#
# The hosted database requires TLS and its certificate is signed by a private
# CA that is not in Node's trust store, so verification is switched on the
# moment DB_SSL_CA is set. Against a local MySQL, leave DB_SSL off.
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=
DB_DIALECT=mysql
DB_LOGGING=false
DB_POOL_MAX=5

# ---- Team 5: Razorpay (test mode) ----
# Dashboard > Account & Settings > API Keys > Generate Key. The browser only
# ever needs the key ID; the secret stays on this server.
# The same key ID goes in Frontend/.env as VITE_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Retry cap per booking (Razorpay recommends 4), and Yatrio's own order
# lifetime. The booking reservation window must be at least as long.
MAX_PAYMENT_ATTEMPTS=4
ORDER_TTL_MINUTES=5

# How long a seat stays held while its booking pays, and how often the sweeper
# clears out the ones whose window closed. Defaults to ORDER_TTL_MINUTES when
# unset — the two deadlines should land together, so a seat is not freed while
# its own payment window is still open. The frontend mirrors
# SEAT_HOLD_TTL_MINUTES for its "Reserved for you" countdown.
SEAT_HOLD_TTL_MINUTES=5
SEAT_SWEEP_INTERVAL_MS=15000

# Console format for payment events: pretty (boxed) or json (one line each)
PAYMENT_LOG_FORMAT=pretty

# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key

# Team 2 External Railway API Adapter Configuration
RAILWAY_API_BASE_URL=
RAILWAY_API_KEY=

# Railway Cache Configuration (in seconds)
CACHE_TTL_SECONDS=300

# Redis Configuration
# Redis is optional. When it is unreachable the API stays fast and correct:
# cache reads fall through to MySQL and the rate limiter counts in memory.
# Set REDIS_ENABLED=false to skip connecting entirely and keep the log clean.
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# --- Rate limiting -----------------------------------------------------
# Both limiters pass through when false. Left mounted either way, so this is
# a flag change and not a code change. Counters live in Redis and survive a
# restart, so also set RATE_LIMIT_FLUSH=true once to clear any existing
# windows after switching this off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FLUSH=false

# Whole-API ceiling per IP per window. 1000 rather than the old 100, which a
# single-page app exhausted within a couple of page loads.
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1000

# Auth attempts per IP per hour. Still the strictest limit — this is the one
# that blunts credential stuffing.
RATE_LIMIT_AUTH_WINDOW_MS=3600000
RATE_LIMIT_AUTH_MAX=50
